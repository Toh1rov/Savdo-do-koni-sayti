
<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Uzum Market</title>

<style>
:root {
  --purple: #7000ff;
  --dark-purple: #5800cc;
  --bg: #f5f5f5;
  --white: #fff;
  --text: #222;
  --muted: #888;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

body {
  background: var(--bg);
  color: var(--text);
}

/* HEADER */
header {
  background: white;
  padding: 15px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
  box-shadow: 0 2px 10px #ddd;
  position: sticky;
  top: 0;
  z-index: 50;
}

.logo {
  font-size: 32px;
  color: var(--purple);
  font-weight: 900;
}

.search {
  display: flex;
  flex: 1;
  max-width: 550px;
}

.search input {
  width: 100%;
  padding: 13px;
  border: 2px solid var(--purple);
  border-radius: 9px 0 0 9px;
  outline: none;
}

.search button {
  background: var(--purple);
  color: white;
  border: none;
  padding: 13px 20px;
  border-radius: 0 9px 9px 0;
  cursor: pointer;
}

.cart-btn {
  background: var(--purple);
  color: white;
  border: none;
  padding: 13px 20px;
  border-radius: 9px;
  cursor: pointer;
  font-weight: bold;
}

/* CATEGORIES */
.categories {
  display: flex;
  gap: 12px;
  padding: 20px 6%;
  overflow-x: auto;
}

.categories button {
  background: white;
  border: none;
  padding: 12px 22px;
  border-radius: 20px;
  white-space: nowrap;
  cursor: pointer;
}

.categories button.active,
.categories button:hover {
  background: var(--purple);
  color: white;
}

/* BANNER */
.banner {
  margin: 10px 6% 30px;
  padding: 45px;
  border-radius: 18px;
  color: white;
  background: linear-gradient(110deg,#7000ff,#a65cff);
}

.banner h1 {
  font-size: 34px;
  margin-bottom: 12px;
}

.banner p {
  margin-bottom: 20px;
}

.banner button {
  background: white;
  color: var(--purple);
  border: none;
  padding: 13px 25px;
  border-radius: 9px;
  font-weight: bold;
  cursor: pointer;
}

/* PRODUCTS */
main {
  padding: 20px 6% 50px;
}

main h2 {
  margin-bottom: 22px;
  font-size: 25px;
}

.products {
  display: grid;
  grid-template-columns: repeat(auto-fill,minmax(210px,1fr));
  gap: 20px;
}

.product {
  background: white;
  border-radius: 14px;
  padding: 12px;
  overflow: hidden;
  transition: 0.3s;
}

.product:hover {
  transform: translateY(-5px);
  box-shadow: 0 5px 20px #ddd;
}

.product img {
  width: 100%;
  height: 190px;
  object-fit: contain;
  border-radius: 10px;
}

.product h3 {
  font-size: 16px;
  margin: 12px 0;
  min-height: 38px;
}

.price {
  color: var(--purple);
  font-size: 19px;
  font-weight: bold;
  margin-bottom: 12px;
}

.add-btn {
  width: 100%;
  padding: 12px;
  background: var(--purple);
  color: white;
  border: none;
  border-radius: 9px;
  cursor: pointer;
}

.add-btn:hover {
  background: var(--dark-purple);
}

/* CART */
.overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: #0008;
  z-index: 100;
}

.overlay.open {
  display: block;
}

.cart-panel {
  position: fixed;
  top: 0;
  right: -420px;
  width: 100%;
  max-width: 400px;
  height: 100vh;
  background: white;
  z-index: 101;
  padding: 20px;
  transition: right .3s;
  display: flex;
  flex-direction: column;
}

.cart-panel.open {
  right: 0;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 15px;
  border-bottom: 1px solid #ddd;
}

.close {
  border: none;
  background: none;
  font-size: 28px;
  cursor: pointer;
}

.cart-items {
  flex: 1;
  overflow-y: auto;
  padding-top: 15px;
}

.cart-item {
  padding: 14px 0;
  border-bottom: 1px solid #ddd;
}

.cart-item button {
  padding: 5px 10px;
  margin: 5px 3px;
  cursor: pointer;
}

.total {
  font-size: 20px;
  font-weight: bold;
  padding: 15px 0;
  border-top: 1px solid #ddd;
}

.order-btn {
  width: 100%;
  background: var(--purple);
  color: white;
  border: none;
  padding: 14px;
  border-radius: 9px;
  cursor: pointer;
  font-weight: bold;
}

footer {
  text-align: center;
  padding: 25px;
  background: #222;
  color: white;
}

/* MOBILE */
@media(max-width:600px) {
  header {
    padding: 14px;
  }

  .banner {
    margin: 10px 12px;
    padding: 25px;
  }

  .banner h1 {
    font-size: 24px;
  }

  main {
    padding: 20px 12px;
  }

  .products {
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 10px;
  }

  .product img {
    height: 140px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">uzum</div>

  <div class="search">
    <input id="search" placeholder="Mahsulotlarni qidirish...">
    <button onclick="searchProducts()">Qidirish</button>
  </div>

  <button class="cart-btn" onclick="toggleCart()">
    🛒 Savatcha (<span id="count">0</span>)
  </button>
</header>

<nav class="categories">
  <button class="active" onclick="filterProducts('Barchasi',this)">Barchasi</button>
  <button onclick="filterProducts('Telefon',this)">Telefonlar</button>
  <button onclick="filterProducts('Kiyim',this)">Kiyimlar</button>
  <button onclick="filterProducts('Texnika',this)">Texnika</button>
  <button onclick="filterProducts('Uy',this)">Uy uchun</button>
</nav>

<section class="banner">
  <h1>Uzum Marketga xush kelibsiz!</h1>
  <p>Minglab mahsulotlar — qulay narxlarda!</p>
  <button onclick="document.querySelector('main').scrollIntoView({behavior:'smooth'})">
    Xarid qilish
  </button>
</section>

<main>
  <h2>🔥 Mashhur mahsulotlar</h2>
  <div class="products" id="products"></div>
</main>

<div class="overlay" id="overlay" onclick="toggleCart()"></div>

<aside class="cart-panel" id="cartPanel">
  <div class="cart-header">
    <h2>🛒 Savatcham</h2>
    <button class="close" onclick="toggleCart()">×</button>
  </div>

  <div class="cart-items" id="cartItems">
  </div>

  <div class="total">
    Jami: <span id="total">0</span> so'm
  </div>

  <button class="order-btn" onclick="orderNow()">
    Buyurtma berish
  </button>
</aside>

<footer>
  © 2026 Uzum Market uslubidagi demo do'kon
</footer>

<script>
const productsData = [
  {
    id:1,
    name:"iPhone 15 Pro Max",
    price:14500000,
    category:"Telefon",
    image:"https://images.unsplash.com/photo-1592899677977-9c10ca588bbd?w=500"
  },
  {
    id:2,
    name:"Samsung Galaxy S24",
    price:9500000,
    category:"Telefon",
    image:"https://images.unsplash.com/photo-1610945265064-0e34e5519bbf?w=500"
  },
  {
    id:3,
    name:"Erkaklar futbolkasi",
    price:85000,
    category:"Kiyim",
    image:"https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=500"
  },
  {
    id:4,
    name:"Lenovo noutbuk",
    price:6500000,
    category:"Texnika",
    image:"https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=500"
  },
  {
    id:5,
    name:"Smart Watch",
    price:350000,
    category:"Texnika",
    image:"https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500"
  },
  {
    id:6,
    name:"Uy uchun chiroq",
    price:120000,
    category:"Uy",
    image:"https://images.unsplash.com/photo-1507473885765-e6ed057f782c?w=500"
  },
  {
    id:7,
    name:"Ayollar sumkasi",
    price:250000,
    category:"Kiyim",
    image:"https://images.unsplash.com/photo-1584917865442-de89df76afd3?w=500"
  },
  {
    id:8,
    name:"Bluetooth quloqchin",
    price:180000,
    category:"Texnika",
    image:"https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500"
  }
];

let cart = [];

function formatPrice(price) {
  return price.toLocaleString("uz-UZ");
}

function showProducts(data) {
  const container = document.getElementById("products");
  container.innerHTML = "";

  data.forEach(product => {
    const card = document.createElement("div");
    card.className = "product";

    card.innerHTML = `
      <img
        src="${product.image}"
        alt="${product.name}"
        onerror="this.src='https://placehold.co/300x250?text=Mahsulot'"
      >
      <h3>${product.name}</h3>
      <div class="price">${formatPrice(product.price)} so'm</div>
      <button class="add-btn" onclick="addToCart(${product.id})">
        Savatchaga qo'shish
      </button>
    `;

    container.appendChild(card);
  });

  if(data.length === 0) {
    container.innerHTML = "<p>Mahsulot topilmadi!</p>";
  }
}

function addToCart(id) {
  const product = productsData.find(p => p.id === id);
  const existing = cart.find(p => p.id === id);

  if(existing) {
    existing.quantity++;
  } else {
    cart.push({...product, quantity:1});
  }

  updateCart();
}

function updateCart() {
  const items = document.getElementById("cartItems");
  let sum = 0;
  let count = 0;

  items.innerHTML = "";

  cart.forEach(item => {
    sum += item.price * item.quantity;
    count += item.quantity;

    items.innerHTML += `
      <div class="cart-item">
        <b>${item.name}</b>
        <p>${formatPrice(item.price)} so'm</p>
        <button onclick="changeQuantity(${item.id},-1)">−</button>
        ${item.quantity}
        <button onclick="changeQuantity(${item.id},1)">+</button>
        <button onclick="removeItem(${item.id})">🗑</button>
      </div>
    `;
  });

  if(cart.length === 0) {
    items.innerHTML = "<p>Savatcha hozircha bo'sh.</p>";
  }

  document.getElementById("total").textContent = formatPrice(sum);
  document.getElementById("count").textContent = count;
}

function changeQuantity(id, amount) {
  const item = cart.find(p => p.id === id);
  if(!item) return;

  item.quantity += amount;

  if(item.quantity <= 0) {
    removeItem(id);
  } else {
    updateCart();
  }
}

function removeItem(id) {
  cart = cart.filter(p => p.id !== id);
  updateCart();
}

function toggleCart() {
  document.getElementById("cartPanel").classList.toggle("open");
  document.getElementById("overlay").classList.toggle("open");
}

function filterProducts(category, button) {
  document.querySelectorAll(".categories button")
    .forEach(btn => btn.classList.remove("active"));

  button.classList.add("active");

  const result = category === "Barchasi"
    ? productsData
    : productsData.filter(p => p.category === category);

  showProducts(result);
}

function searchProducts() {
  const query = document.getElementById("search")
    .value.toLowerCase().trim();

  const result = productsData.filter(p =>
    p.name.toLowerCase().includes(query)
  );

  showProducts(result);
}

document.getElementById("search")
  .addEventListener("input", searchProducts);

function orderNow() {
  if(cart.length === 0) {
    alert("Savatchangiz bo'sh!");
    return;
  }

  alert("Bu demo do'kon. Buyurtma hali serverga yuborilmaydi.");
}

showProducts(productsData);
updateCart();
</script>

</body>
</html>
